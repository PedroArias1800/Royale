server {
    listen 80;
    listen 443 ssl;
    server_name royalepanama.com;

    ssl_certificate /etc/letsencrypt/live/royalepanama.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/royalepanama.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/royalepanama.com;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
        proxy_pass http://93.188.162.15:4001;  # Asegúrate de que esto apunte a tu API correctamente
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
